{%- style -%}
.tisso-lookbook-wrapper {
  max-width: 1200px;
  margin: 40px auto;
  padding: 0 20px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

.tisso-lookbook-heading {
  font-size: 32px;
  font-weight: 400;
  margin-bottom: 25px;
  color: #111;
}

.tisso-grid-layout {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30px 20px;
}

.tisso-card-item {
  display: flex;
  flex-direction: column;
}

.tisso-image-container {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background-color: #f5f5f5;
  margin-bottom: 12px;
}

.tisso-image-container img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Below Image Product Info */
.tisso-card-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.tisso-card-title {
  font-size: 14px;
  font-weight: 400;
  color: #333;
  margin: 0;
}

.tisso-card-price {
  font-size: 14px;
  font-weight: 500;
  color: #111;
  margin: 0;
}

/* Hotspot Plus Button */
.tisso-hotspot-btn {
  position: absolute;
  width: 28px;
  height: 28px;
  background: rgba(255, 255, 255, 0.95);
  border: none;
  border-radius: 50%;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.2);
  transform: translate(-50%, -50%);
  transition: all 0.2s ease;
  z-index: 3;
}

.tisso-hotspot-btn:hover {
  transform: translate(-50%, -50%) scale(1.15);
  background: #ffffff;
}

/* Modal Popup Window */
.tisso-modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

.tisso-modal-backdrop.active {
  display: flex;
}

.tisso-popup-card {
  background: #ffffff;
  width: 350px;
  max-width: 90%;
  padding: 22px;
  position: relative;
  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  border-radius: 2px;
}

.tisso-popup-close {
  position: absolute;
  top: 10px;
  right: 12px;
  background: none;
  border: none;
  font-size: 18px;
  cursor: pointer;
  color: #555;
}

.tisso-product-top {
  display: flex;
  gap: 15px;
  margin-bottom: 15px;
}

.tisso-product-top img {
  width: 85px;
  height: 105px;
  object-fit: cover;
}

.tisso-product-details {
  flex: 1;
}

.tisso-product-details h3 {
  font-size: 15px;
  margin: 0 0 6px 0;
  font-weight: 500;
  color: #111;
}

.tisso-product-details .price {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
  color: #111;
}

.tisso-product-details p {
  font-size: 11px;
  color: #666;
  line-height: 1.4;
  margin: 0;
}

.tisso-field-label {
  font-size: 12px;
  margin: 12px 0 6px;
  color: #333;
}

.tisso-size-select {
  width: 100%;
  padding: 10px;
  border: 1px solid #ccc;
  font-size: 13px;
  background: #fff;
  margin-bottom: 18px;
  cursor: pointer;
}

.tisso-add-cart-btn {
  width: 100%;
  background: #000000;
  color: #ffffff;
  border: none;
  padding: 14px 18px;
  font-size: 12px;
  letter-spacing: 1px;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-transform: uppercase;
  font-weight: 500;
}

@media (max-width: 768px) {
  .tisso-grid-layout {
    grid-template-columns: repeat(1, 1fr);
  }
}
{%- endstyle -%}

<div class="tisso-lookbook-wrapper">
  {% if section.settings.title != blank %}
    <h2 class="tisso-lookbook-heading">{{ section.settings.title }}</h2>
  {% endif %}

  <div class="tisso-grid-layout">
    {% for block in section.blocks %}
      {% assign product = block.settings.selected_product %}
      
      <div class="tisso-card-item" {{ block.shopify_attributes }}>
        <div class="tisso-image-container">
          {% if block.settings.card_image != blank %}
            <img src="{{ block.settings.card_image | image_url: width: 800 }}" alt="Lookbook Image" loading="lazy">
          {% elsif product.featured_image != blank %}
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}

          {% if product != blank %}
            <button class="tisso-hotspot-btn" 
                    style="top: {{ block.settings.top_pos }}%; left: {{ block.settings.left_pos }}%;"
                    data-title="{{ product.title | escape }}"
                    data-price="{{ product.price | money }}"
                    data-desc="{{ product.description | strip_html | truncate: 110 | escape }}"
                    data-image="{{ product.featured_image | image_url: width: 250 }}"
                    data-variants='{{ product.variants | json | escape }}'>
              +
            </button>
          {% endif %}
        </div>

        <!-- Product Title & Price Below Image -->
        <div class="tisso-card-info">
          <p class="tisso-card-title">
            {% if product != blank %}{{ product.title }}{% else %}Product Title{% endif %}
          </p>
          <p class="tisso-card-price">
            {% if product != blank %}{{ product.price | money }}{% else %}$0.00 USD{% endif %}
          </p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<!-- Modal Structure -->
<div class="tisso-modal-backdrop" id="TissoModalWindow">
  <div class="tisso-popup-card">
    <button class="tisso-popup-close" onclick="closeTissoModal()">&times;</button>
    
    <div class="tisso-product-top">
      <img id="tisso-popup-img" src="" alt="Product Image">
      <div class="tisso-product-details">
        <h3 id="tisso-popup-title">Product Name</h3>
        <div class="price" id="tisso-popup-price">$0.00</div>
        <p id="tisso-popup-desc">Product description...</p>
      </div>
    </div>

    <form method="post" action="/cart/add" id="tisso-cart-form">
      <div class="tisso-field-label">Select Size / Option</div>
      <select name="id" id="tisso-variant-dropdown" class="tisso-size-select">
      </select>

      <button type="submit" class="tisso-add-cart-btn">
        <span>ADD TO CART</span>
        <span>&rarr;</span>
      </button>
    </form>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const modal = document.getElementById("TissoModalWindow");
    const hotspotBtns = document.querySelectorAll(".tisso-hotspot-btn");
    const variantSelect = document.getElementById("tisso-variant-dropdown");

    hotspotBtns.forEach(btn => {
      btn.addEventListener("click", function() {
        const title = this.getAttribute("data-title");
        const price = this.getAttribute("data-price");
        const desc = this.getAttribute("data-desc");
        const image = this.getAttribute("data-image");
        const variants = JSON.parse(this.getAttribute("data-variants"));

        document.getElementById("tisso-popup-title").innerText = title;
        document.getElementById("tisso-popup-price").innerText = price;
        document.getElementById("tisso-popup-desc").innerText = desc;
        document.getElementById("tisso-popup-img").src = image;

        variantSelect.innerHTML = "";
        variants.forEach(variant => {
          const option = document.createElement("option");
          option.value = variant.id;
          option.text = variant.title + " - " + (variant.available ? "Available" : "Sold Out");
          if (!variant.available) option.disabled = true;
          variantSelect.appendChild(option);
        });

        modal.classList.add("active");
      });
    });
  });

  function closeTissoModal() {
    document.getElementById("TissoModalWindow").classList.remove("active");
  }

  document.getElementById("TissoModalWindow").addEventListener("click", function(e) {
    if (e.target === this) {
      closeTissoModal();
    }
  });
</script>

{% schema %}
{
  "name": "Shoppable Lookbook Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "image_hotspot",
      "name": "Product Card with Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "selected_product",
          "label": "Select Product"
        },
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Custom Card Image (Optional)"
        },
        {
          "type": "range",
          "id": "top_pos",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Hotspot Top Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "left_pos",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Hotspot Left Position",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable Lookbook Grid",
      "blocks": [
        { "type": "image_hotspot" },
        { "type": "image_hotspot" }
      ]
    }
  ]
}
{% endschema %}