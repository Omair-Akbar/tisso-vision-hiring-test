{%- style -%}
.tisso-wild-section {
  max-width: 1200px;
  margin: 50px auto;
  padding: 0 20px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

.tisso-wild-heading {
  font-size: 28px;
  font-weight: 400;
  margin-bottom: 30px;
  color: #111;
  letter-spacing: 0.5px;
}

.tisso-wild-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.tisso-wild-card {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background-color: #f4f4f4;
}

.tisso-wild-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  pointer-events: none; /* Editor drag/select interfere na kare */
}

/* Hotspot Plus Icon */
.tisso-plus-btn {
  position: absolute;
  width: 28px;
  height: 28px;
  background: rgba(255, 255, 255, 0.95);
  border: none;
  border-radius: 50%;
  font-size: 16px;
  font-weight: 600;
  color: #111;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  transform: translate(-50%, -50%);
  transition: all 0.2s ease;
  z-index: 9999; /* Higher priority over editor blocks */
  padding: 0;
  line-height: 1;
  pointer-events: auto !important;
}

.tisso-plus-btn:hover {
  transform: translate(-50%, -50%) scale(1.15);
  background: #ffffff;
}

/* Quick Shop Modal Popup */
.tisso-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.45);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 9999999 !important;
}

.tisso-modal-mask.active {
  display: flex !important;
}

.tisso-modal-content {
  background: #ffffff;
  width: 350px;
  max-width: 90%;
  padding: 24px;
  position: relative;
  box-shadow: 0 10px 30px rgba(0,0,0,0.25);
  border-radius: 2px;
  z-index: 10000000 !important;
}

.tisso-modal-close-btn {
  position: absolute;
  top: 10px;
  right: 14px;
  background: none;
  border: none;
  font-size: 22px;
  cursor: pointer;
  color: #444;
}

.tisso-modal-header {
  display: flex;
  gap: 15px;
  margin-bottom: 20px;
}

.tisso-modal-header img {
  width: 85px;
  height: 105px;
  object-fit: cover;
}

.tisso-modal-meta {
  flex: 1;
}

.tisso-modal-meta h3 {
  font-size: 15px;
  margin: 0 0 6px 0;
  font-weight: 500;
  color: #111;
}

.tisso-modal-meta .price {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
  color: #111;
}

.tisso-modal-meta p {
  font-size: 11px;
  color: #666;
  line-height: 1.4;
  margin: 0;
}

.tisso-field-title {
  font-size: 12px;
  margin: 12px 0 6px;
  color: #333;
}

.tisso-color-box {
  display: flex;
  border: 1px solid #ccc;
  margin-bottom: 12px;
}

.tisso-color-btn {
  flex: 1;
  padding: 8px 12px;
  border: none;
  background: #fff;
  cursor: pointer;
  font-size: 13px;
  text-align: left;
  border-right: 1px solid #ccc;
}

.tisso-color-btn:last-child {
  border-right: none;
}

.tisso-color-btn.active {
  border: 2px solid #000;
  font-weight: 600;
  margin: -1px;
}

.tisso-dropdown-select {
  width: 100%;
  padding: 10px;
  border: 1px solid #ccc;
  font-size: 13px;
  background: #fff;
  margin-bottom: 20px;
  cursor: pointer;
}

.tisso-cart-submit {
  width: 100%;
  background: #000000;
  color: #ffffff;
  border: none;
  padding: 14px 18px;
  font-size: 12px;
  letter-spacing: 1px;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-transform: uppercase;
  font-weight: 500;
}

@media (max-width: 768px) {
  .tisso-wild-grid {
    grid-template-columns: repeat(1, 1fr);
  }
}
{%- endstyle -%}

<div class="tisso-wild-section">
  {% if section.settings.title != blank %}
    <h2 class="tisso-wild-heading">{{ section.settings.title }}</h2>
  {% endif %}

  <div class="tisso-wild-grid">
    {% for block in section.blocks %}
      {% assign product = block.settings.selected_product %}
      
      <div class="tisso-wild-card" {{ block.shopify_attributes }}>
        {% if block.settings.card_image != blank %}
          <img src="{{ block.settings.card_image | image_url: width: 800 }}" alt="Lookbook Image" loading="lazy">
        {% elsif product.featured_image != blank %}
          <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" loading="lazy">
        {% else %}
          {{ 'image' | placeholder_svg_tag }}
        {% endif %}

        {% if product != blank %}
          <button type="button" 
                  class="tisso-plus-btn" 
                  style="top: {{ block.settings.top_pos }}%; left: {{ block.settings.left_pos }}%;"
                  data-title="{{ product.title | escape }}"
                  data-price="{{ product.price | money }}"
                  data-desc="{{ product.description | strip_html | truncate: 110 | escape }}"
                  data-image="{{ product.featured_image | image_url: width: 250 }}"
                  data-variants='{{ product.variants | json | escape }}'>
            +
          </button>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<div class="tisso-modal-mask" id="TissoWildModal">
  <div class="tisso-modal-content">
    <button type="button" class="tisso-modal-close-btn" id="tissoCloseBtn">&times;</button>
    
    <div class="tisso-modal-header">
      <img id="tisso-modal-img" src="" alt="Product Image">
      <div class="tisso-modal-meta">
        <h3 id="tisso-modal-title">Tailored Jacket</h3>
        <div class="price" id="tisso-modal-price">0,00€</div>
        <p id="tisso-modal-desc">This product description will appear here...</p>
      </div>
    </div>

    <form method="post" action="/cart/add" id="tisso-wild-cart-form">
      <div class="tisso-field-title">Color</div>
      <div class="tisso-color-box">
        <button type="button" class="tisso-color-btn active">Blue</button>
        <button type="button" class="tisso-color-btn">Black</button>
      </div>

      <div class="tisso-field-title">Size</div>
      <select name="id" id="tisso-variant-select-box" class="tisso-dropdown-select">
      </select>

      <button type="submit" class="tisso-cart-submit">
        <span>ADD TO CART</span>
        <span>&rarr;</span>
      </button>
    </form>
  </div>
</div>

<script>
  (function() {
    function initTissoLookbook() {
      const modal = document.getElementById("TissoWildModal");
      const closeBtn = document.getElementById("tissoCloseBtn");
      const variantSelect = document.getElementById("tisso-variant-select-box");

      if (!modal) return;

      // Event delegation se click target capture karna
      document.body.addEventListener("click", function(e) {
        const btn = e.target.closest(".tisso-plus-btn");
        if (btn) {
          e.preventDefault();
          e.stopPropagation();

          const title = btn.getAttribute("data-title");
          const price = btn.getAttribute("data-price");
          const desc = btn.getAttribute("data-desc");
          const image = btn.getAttribute("data-image");
          const variantsRaw = btn.getAttribute("data-variants");

          if (title) document.getElementById("tisso-modal-title").innerText = title;
          if (price) document.getElementById("tisso-modal-price").innerText = price;
          if (desc) document.getElementById("tisso-modal-desc").innerText = desc;
          if (image) document.getElementById("tisso-modal-img").src = image;

          if (variantsRaw && variantSelect) {
            try {
              const variants = JSON.parse(variantsRaw);
              variantSelect.innerHTML = "";
              variants.forEach(variant => {
                const option = document.createElement("option");
                option.value = variant.id;
                option.text = variant.title + " - " + (variant.available ? "In Stock" : "Sold Out");
                if (!variant.available) option.disabled = true;
                variantSelect.appendChild(option);
              });
            } catch (err) {
              console.error("Variant JSON parse error", err);
            }
          }

          modal.classList.add("active");
        }
      }, true);

      if (closeBtn) {
        closeBtn.addEventListener("click", function(e) {
          e.preventDefault();
          modal.classList.remove("active");
        });
      }

      modal.addEventListener("click", function(e) {
        if (e.target === modal) {
          modal.classList.remove("active");
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTissoLookbook);
    } else {
      initTissoLookbook();
    }

    // Shopify Customizer Editor re-load handle karne ke liye
    if (window.Shopify && Shopify.designMode) {
      document.addEventListener("shopify:section:load", initTissoLookbook);
      document.addEventListener("shopify:block:select", initTissoLookbook);
    }
  })();
</script>

{% schema %}
{
  "name": "Tisso Wild Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "hotspot_card",
      "name": "Product Hotspot Card",
      "settings": [
        {
          "type": "product",
          "id": "selected_product",
          "label": "Select Product (CSV)"
        },
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Custom Card Image (Optional)"
        },
        {
          "type": "range",
          "id": "top_pos",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Plus Icon Top Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "left_pos",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Plus Icon Left Position",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tisso Wild Lookbook",
      "blocks": [
        { "type": "hotspot_card" },
        { "type": "hotspot_card" },
        { "type": "hotspot_card" },
        { "type": "hotspot_card" },
        { "type": "hotspot_card" },
        { "type": "hotspot_card" }
      ]
    }
  ]
}
{% endschema %}