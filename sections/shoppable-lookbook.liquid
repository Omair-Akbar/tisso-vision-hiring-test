{%- style -%}
.tisso-grid-container {
  max-width: 1200px;
  margin: 40px auto;
  padding: 0 20px;
}

.tisso-grid-title {
  font-size: 32px;
  font-weight: 400;
  margin-bottom: 30px;
  color: #111;
  font-family: inherit;
}

.tisso-image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.tisso-image-card {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1.1;
  overflow: hidden;
}

.tisso-image-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Plus Hotspot Button */
.hotspot-icon-btn {
  position: absolute;
  width: 28px;
  height: 28px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(0, 0, 0, 0.1);
  border-radius: 50%;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  transform: translate(-50%, -50%);
  transition: all 0.2s ease;
  z-index: 3;
}

.hotspot-icon-btn:hover {
  transform: translate(-50%, -50%) scale(1.15);
  background: #ffffff;
}

/* Quick Shop Popup Modal */
.tisso-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 99999;
}

.tisso-modal-overlay.active {
  display: flex;
}

.tisso-modal-box {
  background: #ffffff;
  width: 360px;
  max-width: 90%;
  padding: 24px;
  position: relative;
  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  border-radius: 2px;
}

.tisso-modal-close {
  position: absolute;
  top: 10px;
  right: 14px;
  background: none;
  border: none;
  font-size: 22px;
  cursor: pointer;
  color: #444;
}

.tisso-modal-header {
  display: flex;
  gap: 15px;
  margin-bottom: 20px;
}

.tisso-modal-header img {
  width: 85px;
  height: 105px;
  object-fit: cover;
}

.tisso-modal-info h3 {
  font-size: 16px;
  margin: 0 0 6px 0;
  font-weight: 500;
  color: #111;
}

.tisso-modal-info .price {
  font-size: 14px;
  font-weight: 600;
  margin-bottom: 8px;
  color: #222;
}

.tisso-modal-info p {
  font-size: 11px;
  color: #666;
  line-height: 1.45;
  margin: 0;
}

.tisso-option-label {
  font-size: 12px;
  margin: 15px 0 6px;
  color: #333;
}

.tisso-variant-select {
  width: 100%;
  padding: 10px;
  border: 1px solid #ccc;
  font-size: 13px;
  background: #fff;
  margin-bottom: 15px;
}

.tisso-cart-btn {
  width: 100%;
  background: #000000;
  color: #ffffff;
  border: none;
  padding: 14px;
  font-size: 12px;
  letter-spacing: 1px;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-transform: uppercase;
  margin-top: 10px;
}

@media (max-width: 768px) {
  .tisso-image-grid {
    grid-template-columns: repeat(1, 1fr);
  }
}
{%- endstyle -%}

<div class="tisso-grid-container">
  {% if section.settings.title != blank %}
    <h2 class="tisso-grid-title">{{ section.settings.title }}</h2>
  {% endif %}

  <div class="tisso-image-grid">
    {% for block in section.blocks %}
      <div class="tisso-image-card" {{ block.shopify_attributes }}>
        {% if block.settings.card_image != blank %}
          <img src="{{ block.settings.card_image | image_url: width: 800 }}" alt="Lookbook Item" loading="lazy">
        {% else %}
          {{ 'image' | placeholder_svg_tag }}
        {% endif %}

        {% if block.settings.selected_product != blank %}
          {% assign product = block.settings.selected_product %}
          <button class="hotspot-icon-btn" 
                  style="top: {{ block.settings.top_pos }}%; left: {{ block.settings.left_pos }}%;"
                  data-title="{{ product.title | escape }}"
                  data-price="{{ product.price | money }}"
                  data-desc="{{ product.description | strip_html | truncate: 120 | escape }}"
                  data-image="{{ product.featured_image | image_url: width: 250 }}"
                  data-variants='{{ product.variants | json | escape }}'>
            +
          </button>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<!-- Modal Popup -->
<div class="tisso-modal-overlay" id="TissoQuickShopModal">
  <div class="tisso-modal-box">
    <button class="tisso-modal-close" onclick="closeTissoModal()">&times;</button>
    
    <div class="tisso-modal-header">
      <img id="tisso-modal-img" src="" alt="Product Image">
      <div class="tisso-modal-info">
        <h3 id="tisso-modal-title">Product Name</h3>
        <div class="price" id="tisso-modal-price">0,00€</div>
        <p id="tisso-modal-desc">Product description...</p>
      </div>
    </div>

    <form method="post" action="/cart/add" id="tisso-cart-form">
      <div class="tisso-option-label">Select Option / Size</div>
      <select name="id" id="tisso-variant-select" class="tisso-variant-select">
      </select>

      <button type="submit" class="tisso-cart-btn">
        <span>ADD TO CART</span>
        <span>&rarr;</span>
      </button>
    </form>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const modal = document.getElementById("TissoQuickShopModal");
    const hotspotBtns = document.querySelectorAll(".hotspot-icon-btn");
    const variantSelect = document.getElementById("tisso-variant-select");

    hotspotBtns.forEach(btn => {
      btn.addEventListener("click", function() {
        // Fetch values from hotspot data attributes
        const title = this.getAttribute("data-title");
        const price = this.getAttribute("data-price");
        const desc = this.getAttribute("data-desc");
        const image = this.getAttribute("data-image");
        const variants = JSON.parse(this.getAttribute("data-variants"));

        document.getElementById("tisso-modal-title").innerText = title;
        document.getElementById("tisso-modal-price").innerText = price;
        document.getElementById("tisso-modal-desc").innerText = desc;
        document.getElementById("tisso-modal-img").src = image;

        // Populate Variants / Sizes Dropdown
        variantSelect.innerHTML = "";
        variants.forEach(variant => {
          const option = document.createElement("option");
          option.value = variant.id;
          option.text = variant.title + " - " + (variant.available ? "In Stock" : "Sold Out");
          if (!variant.available) option.disabled = true;
          variantSelect.appendChild(option);
        });

        modal.classList.add("active");
      });
    });
  });

  function closeTissoModal() {
    document.getElementById("TissoQuickShopModal").classList.remove("active");
  }

  document.getElementById("TissoQuickShopModal").addEventListener("click", function(e) {
    if (e.target === this) {
      closeTissoModal();
    }
  });
</script>

{% schema %}
{
  "name": "Shoppable Lookbook",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Tisso vision in the wild"
    }
  ],
  "blocks": [
    {
      "type": "image_hotspot",
      "name": "Image with Hotspot",
      "settings": [
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Select Card Image"
        },
        {
          "type": "product",
          "id": "selected_product",
          "label": "Select Product for Modal"
        },
        {
          "type": "range",
          "id": "top_pos",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Plus Icon Top Position",
          "default": 50
        },
        {
          "type": "range",
          "id": "left_pos",
          "min": 5,
          "max": 95,
          "step": 1,
          "unit": "%",
          "label": "Plus Icon Left Position",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable Lookbook",
      "blocks": [
        { "type": "image_hotspot" },
        { "type": "image_hotspot" },
        { "type": "image_hotspot" }
      ]
    }
  ]
}
{% endschema %}