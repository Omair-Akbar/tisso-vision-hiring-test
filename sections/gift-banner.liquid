<section class="gift-banner" id="GiftBanner-{{ section.id }}">
  <div class="gift-banner__content">
    <h1>{{ section.settings.heading }}</h1>

    <div class="gift-banner__description">
      {{ section.settings.description }}
    </div>

    {% if section.settings.button_link != blank %}
      <a
        class="gift-banner__button"
        href="{{ section.settings.button_link }}"
      >
        <span>{{ section.settings.button_text }}</span>
        <span class="gift-banner__arrow">→</span>
      </a>
    {% endif %}
  </div>

  <div class="gift-banner__image">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          loading: 'eager',
          widths: '600, 900, 1200, 1600',
          sizes: '50vw',
          alt: section.settings.heading
      }}
    {% endif %}
  </div>
</section>

<div class="gift-banner__announcement">
  {{ section.settings.announcement }}
</div>

<style>
  #GiftBanner-{{ section.id }} {
    display: grid;
    grid-template-columns: 40% 60%;
    min-height: 590px;
    background: #fff;
    overflow: hidden;
  }

  #GiftBanner-{{ section.id }} .gift-banner__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 50px 6vw 50px 0;
  }

  #GiftBanner-{{ section.id }} h1 {
    margin: 0 0 28px;
    color: #000;
    font-size: clamp(42px, 4.4vw, 78px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -2px;
  }

  #GiftBanner-{{ section.id }} .gift-banner__description {
    max-width: 570px;
    color: #111;
    font-size: clamp(18px, 1.5vw, 27px);
    line-height: 1.55;
  }

  #GiftBanner-{{ section.id }} .gift-banner__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    min-width: 300px;
    margin-top: 65px;
    padding: 23px 25px;
    color: #fff;
    background: #000;
    text-decoration: none;
    font-size: 19px;
    transition: background 0.25s ease;
  }

  #GiftBanner-{{ section.id }} .gift-banner__button:hover {
    background: #333;
  }

  #GiftBanner-{{ section.id }} .gift-banner__arrow {
    font-size: 34px;
    line-height: 0;
    transition: transform 0.25s ease;
  }

  #GiftBanner-{{ section.id }} .gift-banner__button:hover .gift-banner__arrow {
    transform: translateX(8px);
  }

  #GiftBanner-{{ section.id }} .gift-banner__image {
    min-width: 0;
    height: 100%;
  }

  #GiftBanner-{{ section.id }} .gift-banner__image img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 590px;
    object-fit: cover;
  }

  .gift-banner__announcement {
    padding: 12px 20px;
    color: #111;
    background: #f4f4f4;
    text-align: center;
    font-size: 18px;
    letter-spacing: 0.5px;
  }

  @media screen and (max-width: 749px) {
    #GiftBanner-{{ section.id }} {
      display: flex;
      flex-direction: column-reverse;
      min-height: auto;
    }

    #GiftBanner-{{ section.id }} .gift-banner__image,
    #GiftBanner-{{ section.id }} .gift-banner__image img {
      min-height: 330px;
      height: 330px;
    }

    #GiftBanner-{{ section.id }} .gift-banner__content {
      padding: 35px 20px 45px;
    }

    #GiftBanner-{{ section.id }} h1 {
      margin-bottom: 20px;
      font-size: 48px;
      letter-spacing: -1px;
    }

    #GiftBanner-{{ section.id }} .gift-banner__description {
      font-size: 18px;
      line-height: 1.45;
    }

    #GiftBanner-{{ section.id }} .gift-banner__button {
      width: 100%;
      min-width: 0;
      margin-top: 35px;
      padding: 19px 20px;
      font-size: 16px;
    }

    .gift-banner__announcement {
      font-size: 13px;
      line-height: 1.4;
    }
  }
</style>

{% schema %}
{
  "name": "Gift banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.<br>Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Gift banner"
    }
  ]
}
{% endschema %}