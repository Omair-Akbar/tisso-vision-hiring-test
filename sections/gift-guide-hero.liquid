{%- style -%}
.tisso-hero-wrapper {
  position: relative;
  width: 100%;
  background-color: #ffffff;
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

.tisso-hero-banner {
  background-color: #f7f7f7;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 40px;
  font-size: 14px;
}

.tisso-hero-banner .banner-text {
  flex-grow: 1;
  text-align: center;
  color: #333;
}

.tisso-hero-banner .banner-btn {
  background-color: #f6f056;
  color: #000;
  text-decoration: none;
  padding: 8px 20px;
  font-weight: 500;
  font-size: 13px;
  letter-spacing: 0.5px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  text-transform: uppercase;
}

.tisso-hero-content-wrap {
  position: relative;
  min-height: 550px;
  display: flex;
  align-items: center;
  padding: 60px 40px;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.tisso-hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}

.tisso-hero-text-box {
  position: relative;
  z-index: 2;
  max-width: 420px;
  background: rgba(255, 255, 255, 0.85);
  padding: 30px;
  backdrop-filter: blur(3px);
}

.tisso-hero-title {
  font-size: 48px;
  font-weight: 600;
  margin: 0 0 20px 0;
  color: #111;
  line-height: 1.1;
}

.tisso-hero-desc {
  font-size: 14px;
  line-height: 1.6;
  color: #444;
  margin-bottom: 30px;
}

.tisso-hero-cta {
  background-color: #000000;
  color: #ffffff;
  padding: 14px 28px;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 15px;
  font-size: 12px;
  letter-spacing: 1px;
  text-transform: uppercase;
  font-weight: 600;
}

.tisso-hero-footer {
  text-align: center;
  padding: 12px 20px;
  border-top: 1px solid #eee;
  font-size: 11px;
  letter-spacing: 1.5px;
  color: #333;
  text-transform: uppercase;
  font-weight: 600;
}

@media (max-width: 768px) {
  .tisso-hero-banner {
    flex-direction: column;
    gap: 10px;
    padding: 10px 15px;
  }
  .tisso-hero-content-wrap {
    min-height: 400px;
    padding: 30px 20px;
  }
  .tisso-hero-title {
    font-size: 36px;
  }
}
{%- endstyle -%}

<div class="tisso-hero-wrapper">
  <div class="tisso-hero-banner">
    <div class="brand-logo" style="font-weight: 700; font-size: 18px; letter-spacing: 1px; color: #000; text-transform: uppercase;">
      TISSO VISION
    </div>
    <div class="banner-text">{{ section.settings.banner_text }}</div>
    <a href="{{ section.settings.banner_link | default: '#' }}" class="banner-btn">
      {{ section.settings.banner_btn_text }} &rarr;
    </a>
  </div>

  <div class="tisso-hero-content-wrap">
    {% if section.settings.bg_image != blank %}
      <img src="{{ section.settings.bg_image | image_url: width: 2000 }}" alt="Hero Background" class="tisso-hero-bg" loading="lazy">
    {% else %}
      <img src="{{ 'hero-bg.png' | asset_url }}" alt="Hero Background" class="tisso-hero-bg" loading="lazy">
    {% endif %}

    <div class="tisso-hero-text-box">
      <h1 class="tisso-hero-title">{{ section.settings.heading }}</h1>
      <div class="tisso-hero-desc">{{ section.settings.description }}</div>
      <a href="{{ section.settings.button_link | default: '#' }}" class="tisso-hero-cta">
        {{ section.settings.button_label }} &rarr;
      </a>
    </div>
  </div>

  <div class="tisso-hero-footer">
    {{ section.settings.footer_text }}
  </div>
</div>

{% schema %}
{
  "name": "Gift Guide Hero",
  "settings": [
    {
      "type": "text",
      "id": "banner_text",
      "label": "Top Banner Text",
      "default": "Find the ideal gift for your loved ones."
    },
    {
      "type": "text",
      "id": "banner_btn_text",
      "label": "Top Button Label",
      "default": "CHOOSE GIFT"
    },
    {
      "type": "url",
      "id": "banner_link",
      "label": "Top Button Link"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Pattern/Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL"
    }
  ],
  "presets": [
    {
      "name": "Gift Guide Hero"
    }
  ]
}
{% endschema %}